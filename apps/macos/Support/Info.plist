<dict>
	<key>SUFeedURL</key>
	<string>$(ARALO_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(ARALO_SPARKLE_PUBLIC_KEY)</string>
</dict>
</plist>

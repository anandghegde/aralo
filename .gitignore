# Rust
# Cargo.lock IS committed: the workspace ships binaries (the app and the CLI).
target/
**/*.rs.bk

# proptest writes failing seeds to `proptest-regressions/` next to the tests.
# Those files are regression tests and MUST be committed. Never ignore them;
# the negation below guards against a broader pattern catching them later.
!**/proptest-regressions/
!**/proptest-regressions/**

# cargo-fuzz: keep the fuzz targets, drop what a run produces.
**/fuzz/target/
**/fuzz/artifacts/
**/fuzz/coverage/

# Generated by `make bootstrap` / `make xcframework`: the UniFFI Swift bindings
# and the XCFramework. Rebuilt from crates/aralo-ffi, never edited by hand.
apps/macos/Generated/

# Fetched by `make model` (scripts/fetch-model.sh): the embedding model's
# weights, checked against the checksums in the script. Not source.
/models/

# Made by scripts/release.sh (the release) and `mdbook build` (the docs site).
/dist/
/book/

# Generated by xcodegen from apps/macos/project.yml. Edit project.yml instead.
apps/macos/*.xcodeproj/
apps/macos/**/*.xcodeproj/

# Xcode and SwiftPM
xcuserdata/
DerivedData/
*.xcuserstate
*.xcscmblueprint
*.xcresult
*.dSYM/
*.dSYM.zip
.build/
.swiftpm/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Desktop.ini

# Secrets and local environment. API keys never belong in this repository.
.env
.env.*
!.env.example

# Editors and tools
.serena/
.idea/
.vscode/
.zed/
.fleet/
*.swp
*.swo
*~
.#*
\#*#
*.iml

# Benchmark and coverage output that lands outside target/
*.profraw
*.profdata
lcov.info
flamegraph.svg
perf.data*
